@page "/periodreport"
@inject IHttpClientFactory HttpClientFactory
@using Common.ViewModels
@inject ApiService ApiService

<h3>Period Report</h3>

<label>Start Date:</label>
<input type="date" @bind="startDate" @bind:event="oninput" />

<label>End Date:</label>
<input type="date" @bind="endDate" @bind:event="oninput" />

<button @onclick="GetPeriodReport">Get Report</button>

@if (periodReport != null)
{
    <h4>Report from @periodReport.StartDate.ToShortDateString() to @periodReport.EndDate.ToShortDateString()</h4>
    <p>Total Income: @periodReport.TotalIncome</p>
    <p>Total Expenses: @periodReport.TotalExpenses</p>

    <table class="table">
        <thead>
            <tr>
                <th>Amount</th>
                <th>Comment</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in periodReport.Transactions)
            {
                <tr>
                    <td>@transaction.Amount</td>
                    <td>@transaction.Comment</td>
                    <td>@transaction.TransactionDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p style="color: red;">@errorMessage</p>
}

@code {
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private PeriodReportViewModel? periodReport;
    private string? errorMessage;

    private async Task GetPeriodReport()
    {
        try
        {
            periodReport = await ApiService.GetPeriodReportAsync(startDate, endDate);
            if (periodReport == null)
            {
                errorMessage = "No data found for the selected period.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
    }
}
